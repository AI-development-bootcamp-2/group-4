{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-eval": "off",
    "no-prototype-builtins": "warn",
    "prefer-const": "warn",
    "semi": ["warn", "always"],
    "quotes": ["warn", "single"]
  }
}
